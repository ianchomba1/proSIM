    "code": "build_features() and build_call_features() in ml-training/notebooks/01_misuse_training.ipynb"
  },
  "history_needed_to_score_one_day": "the SIM's earlier daily rows (14 days for the 14-day baselines, all earlier days for the long-term baselines), its earlier call/SMS destinations (for new-number shares), and its raw Isolation Forest scores for the 2 previous days (for the 3-day average)",
  "models": {
    "random_forest": {
      "file": "random_forest.joblib",
      "features": "all_in_order",
      "classes": [
        "bulk_sms",
        "call_abuse",
        "data_reselling",
        "ghost_usage",
        "inactive_billing",
        "normal",
        "sim_box",
        "unauthorized_sharing"
      ],
      "params": {
        "n_estimators": 400,
        "max_depth": null,
        "min_samples_leaf": 5,
        "class_weight": "balanced_subsample"
      },
      "output": "predicted class; misuse score = 1 - P(normal)"
    },
    "data_isolation_forest": {
      "file": "data_isolation_forest.joblib",
      "features": "data",
      "params": {
        "n_estimators": 300,
        "max_samples": 4096,
        "max_features": 0.5
      },
      "score": "-score_samples(x), then the mean of the SIM's scores today and on the previous 2 days",
      "smooth_window_days": 3,
      "thresholds": {
        "unusual": 0.39064699946632764,
        "strict_review": 0.44174773475392887
      },
      "budgets": {
        "unusual": 0.0667,
        "strict_review": 0.02
      }
    },
    "call_sms_isolation_forest": {
      "file": "call_sms_isolation_forest.joblib",
      "features": "call_sms",
      "params": {
        "n_estimators": 300,
        "max_samples": 4096,
        "max_features": 1.0
      },
      "score": "-score_samples(x), then the mean of the SIM's scores today and on the previous 2 days",
      "smooth_window_days": 3,
      "thresholds": {
        "review": 0.48457467017763567
      },
      "budgets": {
        "review": 0.01
      }
    }
  },
  "alert_rules": [
    {
      "level": "High",
      "when": "Random Forest predicts misuse AND data IF score >= unusual threshold",
      "shows": "misuse type from the Random Forest"
    },
    {
      "level": "Alert",
      "when": "Random Forest predicts misuse",
      "shows": "misuse type from the Random Forest"
    },
    {
      "level": "Review",
      "when": "Random Forest predicts normal AND data IF score >= strict_review threshold",
      "shows": "unusual data use, type unknown"
    },
    {
      "level": "Review (calls/SMS)",
      "when": "Random Forest predicts normal AND call/SMS IF score >= review threshold",
      "shows": "unusual calling/SMS, type unknown"
    }
  ]
